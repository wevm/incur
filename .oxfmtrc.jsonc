{
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "tabWidth": 2,
  "printWidth": 100,
  "ignorePatterns": [
    "package.json",
    // Shared differential fixtures: invalid JSON by design, and one case per line.
    "langs/differential/cases.json",
    "langs/differential/config",
  ],
  "experimentalSortImports": {
    "groups": [
      ["value-builtin", "value-external", "type-import", "value-internal", "type-internal"],
      ["value-parent", "value-sibling", "value-index", "type-parent", "type-sibling", "type-index"],
      "unknown",
    ],
  },
}
